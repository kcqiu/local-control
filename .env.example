# Optional overrides. The defaults match the standard folder and desktop
# launcher names under the current Windows user's profile.
LOCAL_CONTROL_RECGOV_PATH=
LOCAL_CONTROL_REGISTER2PARK_PATH=
LOCAL_CONTROL_RECGOV_LAUNCHER=
LOCAL_CONTROL_REGISTER2PARK_LAUNCHER=

# Dashboard network settings
DASHBOARD_PORT=3333
# Leave blank to detect the Tailscale IPv4 address automatically.
DASHBOARD_HOST=
