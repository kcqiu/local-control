# Comma-separated service IDs. Use short IDs containing letters, numbers,
# dashes, or underscores. Add another block for every ID in this list.
LOCAL_CONTROL_SERVICE_IDS=alpha,beta

# Service: alpha (explicit port)
LOCAL_CONTROL_SERVICE_ALPHA_NAME=Alpha Dashboard
LOCAL_CONTROL_SERVICE_ALPHA_DESCRIPTION=First local Next.js service
LOCAL_CONTROL_SERVICE_ALPHA_PROJECT_PATH=C:\path\to\alpha
LOCAL_CONTROL_SERVICE_ALPHA_LAUNCHER=C:\path\to\Alpha Launcher.cmd
LOCAL_CONTROL_SERVICE_ALPHA_PORT=3000
LOCAL_CONTROL_SERVICE_ALPHA_STATUS_PATH=/api/status
LOCAL_CONTROL_SERVICE_ALPHA_OPEN_PATH=/
LOCAL_CONTROL_SERVICE_ALPHA_ENV_FILE=.env
LOCAL_CONTROL_SERVICE_ALPHA_NTFY_ENV_KEY=NTFY_TOPIC

# Service: beta (port read from the project's own .env)
LOCAL_CONTROL_SERVICE_BETA_NAME=Beta Worker
LOCAL_CONTROL_SERVICE_BETA_DESCRIPTION=Second local Next.js service
LOCAL_CONTROL_SERVICE_BETA_PROJECT_PATH=C:\path\to\beta
LOCAL_CONTROL_SERVICE_BETA_LAUNCHER=C:\path\to\Beta Launcher.lnk
LOCAL_CONTROL_SERVICE_BETA_PORT=3100
LOCAL_CONTROL_SERVICE_BETA_PORT_ENV_KEY=APP_PORT
LOCAL_CONTROL_SERVICE_BETA_STATUS_PATH=/api/status
LOCAL_CONTROL_SERVICE_BETA_OPEN_PATH=/
LOCAL_CONTROL_SERVICE_BETA_ENV_FILE=.env
LOCAL_CONTROL_SERVICE_BETA_NTFY_ENV_KEY=NTFY_TOPIC

# Local Control network settings
DASHBOARD_PORT=3333
# Leave blank to detect the Tailscale IPv4 address automatically.
DASHBOARD_HOST=
